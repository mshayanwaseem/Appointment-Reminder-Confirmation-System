    {
      "parameters": {
        "promptType": "define",
        "text": "=You are reading a patient's reply to an appointment reminder for a dental clinic. Based on the reply text below, classify it into exactly one status: confirmed, reschedule, or unclear.\n\nRules:\n1. If the reply clearly confirms attendance (e.g., \"yes\", \"I'll be there\", \"confirmed\", \"see you then\"), classify as \"confirmed\".\n2. If the reply asks to change the appointment time/date, or says they can't make it (e.g., \"reschedule\", \"can we do another day\", \"I can't come\"), classify as \"reschedule\".\n3. If the reply is ambiguous, unrelated, or doesn't clearly fall into either category, classify as \"unclear\".\n\nPatient's reply:\n{{ $json.reply_text }}\n\nReturn ONLY valid JSON in this exact format, no other text:\n{\n  \"status\": \"confirmed\" | \"reschedule\" | \"unclear\",\n  \"reason\": \"one short sentence explaining the classification\"\n}",
        "hasOutputParser": true,
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        208,
